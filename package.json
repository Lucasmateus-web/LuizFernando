{
  "name": "constrein-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:architecture",
    "test:report": "playwright show-report artifacts/playwright-report",
    "visual:check": "node scripts/glass-visual.mjs",
    "fonts:sync": "node scripts/sync-fonts.mjs",
    "format": "prettier --write src tests scripts *.json *.mjs *.ts",
    "format:check": "prettier --check src tests scripts *.json *.mjs *.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.4",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.564.0",
    "next": "16.2.0",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.0",
    "postcss": "^8.5",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3"
  }
}
